{
  "name": "@raikada/recorder-web",
  "version": "0.1.0",
  "private": true,
  "description": "Recording Server configuration SPA. Built with Vite, embedded into the recorder Go binary at compile time.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p cypress/tsconfig.json --noEmit",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.1.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^15.14.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
